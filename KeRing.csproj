<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      版本号只有这一个地方定义（AppVersion）：exe 文件名跟着它走，窗口标题栏和自检命令
      读的是程序集里的版本（见 App/AppInfo.cs）。**改版本只改这一行。**
      文件名形如 "KeRing 1.5.0.exe"——使用方 2026-09-20 要求"从 exe 文件名到窗口顶部栏都带版本号"。
    -->
    <AppVersion>1.5.0</AppVersion>
    <Version>$(AppVersion)</Version>
    <FileVersion>$(AppVersion)</FileVersion>
    <InformationalVersion>$(AppVersion)</InformationalVersion>
    <!-- 默认会把 git 提交号缀在产品版本后面（1.5.0+abc1234），属性对话框里看着乱，关掉 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>KeRing $(AppVersion)</AssemblyName>
    <RootNamespace>KeRing</RootNamespace>
    <AssemblyTitle>智能课表打铃</AssemblyTitle>
    <Product>智能课表打铃</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!--
      NAudio 必须留在 1.10.0，**不要随手升级**：2.x 把实现拆成了 NAudio.Core / NAudio.Wasapi /
      NAudio.WinMM 等包，而那些包**只发布了 netstandard2.0**，于是程序运行时需要系统的 netstandard
      桥接程序集——那是 .NET Framework **4.7.1 以后**才有的东西。教室一体机常见的 Win10 LTSC / 精简系统
      只有 4.6.x，会直接崩在启动第一步（"未能加载文件或程序集 netstandard, Version=2.0.0.0"，
      2026-09-17 在一台大屏一体机上实测到）。1.10.0 带 net35 版本，net472 会自动选它，
      只依赖 mscorlib / System，老机器照样能跑。
    -->
    <PackageReference Include="NAudio" Version="1.10.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
    <Reference Include="System.Speech" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" />
    <EmbeddedResource Include="Assets\bell.wav" />
    <EmbeddedResource Include="Assets\watermark.jpg" />
  </ItemGroup>

</Project>
